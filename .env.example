# Flask
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-secret
APP_DEBUG=0
HOST=0.0.0.0
PORT=5001
PREFERRED_URL_SCHEME=http
SERVER_NAME=

# Database
# Local dev can use DATABASE_PATH. Vercel/production must use Supabase Postgres DATABASE_URL.
DATABASE_PATH=app.db
DATABASE_URL="postgresql://postgres.vnbrcjtaerwxspigwqzp:Fs9UUg9zz49nVsFu@aws-1-eu-central-1.pooler.supabase.com:6543/postgres"


# SQLAlchemy pool settings for serverless/Supabase
SQLALCHEMY_POOL_SIZE=1
SQLALCHEMY_MAX_OVERFLOW=4
SQLALCHEMY_POOL_TIMEOUT=10
SQLALCHEMY_POOL_RECYCLE=180

# Supabase Storage. Required on Vercel.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=barage-uploads
SUPABASE_STORAGE_PREFIX=uploads

# Local fallback uploads only. Do not use local uploads on Vercel.
UPLOAD_FOLDER=public/static/uploads
SERVICE_INVOICE_MAP_PATH=service_invoice_images.json
LOG_DIR=logs
APP_LOG_PATH=logs/app.log
BACKFILL_MARKER_PATH=.backfill_user_locations_once

# Upload limits
MAX_IMAGE_UPLOAD_SIZE=8388608
MAX_REQUEST_SIZE=33554432
